 kern_return_t
 vm_stats(void *info, unsigned int *count)
@@ -828,7 +831,7 @@ vm_stats(void *info, unsigned int *count)
 	natural_t speculative_count = vm_page_speculative_count;
 	natural_t throttled_count = vm_page_throttled_count;
 
