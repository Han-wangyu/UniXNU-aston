 _Static_assert(HOST_VM_INFO64_COUNT <= HOST_INFO_MAX,
     "vm_statistics64_data_t exceeds maximum host_info size");
+_Static_assert(ASTON_HOST_VM_INFO64_IOS27_COUNT <= HOST_INFO_MAX,
